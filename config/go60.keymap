/ {
behaviors {

    hml: home_row_mod_left {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        require-prior-idle-ms = <100>;
        tapping-term-ms = <270>;
        quick-tap-ms = <175>;
        bindings = <&kp>, <&kp>;
        hold-trigger-key-positions = <
          ALL_RIGHT_KEYS
        >;
        hold-trigger-on-release;
    };

    hmr: home_row_mod_right {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        require-prior-idle-ms = <100>;
        tapping-term-ms = <270>;
        quick-tap-ms = <175>;
        bindings = <&kp>, <&kp>;
        hold-trigger-key-positions = <
          ALL_LEFT_KEYS
        >;
        hold-trigger-on-release;
    };

    EscCW: tap_dance_0 {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <200>;
        bindings = <&kp ESC>, <&caps_word>;
    };

    spc_tab: space_tab {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp SPACE>, <&kp TAB>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = <(MOD_RSFT)>;
    };

    bspc_del: backspace_delete {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp BACKSPACE>, <&kp DELETE>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = <(MOD_RSFT)>;
    };

};
};

/* Quick tap to hold down tap key in mod-tap keys */
&mt {
  quick-tap-ms = <150>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        keypad_numlock_on {
            if-layers = <LAYER_Keypad>;
            then-layer = <LAYER_KeypadNumOn>;
        };

        keypad_numlock_off {
            if-layers = <LAYER_Keypad LAYER_NumSwitch>;
            then-layer = <LAYER_KeypadNumOff>;
        };

        /* base_rainbow_toggle { */
        /*     if-layers = <LAYER_Base LAYER_BaseRainbowSwitch>; */
        /*     then-layer = <LAYER_BaseRainbow>; */
        /* }; */

    };
};


