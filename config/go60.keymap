 &bootloader  &rgb_ug RGB_SPI &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG     &tog LAYER_BaseRainbow      &none        &none        &none &none &bootloader
 &sys_reset   &rgb_ug RGB_SPD &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF     &none      &none        &none        &none &none &sys_reset
 &none        &none           &bt_0           &bt_1           &bt_2           &bt_3               &none      &none        &none        &none &none &to LAYER_Factory
                                                       &out OUT_USB &none           &none           &none           &none           &none
                                                       &none        &none           &none           &none           &none           &none
            >;
        };

// 7
layer_KeypadNumOn {
    bindings = <
    &trans  &trans  &trans  &trans  &trans  &trans                                                      &trans     &trans     &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                                   &kp N7  &kp N8  &kp N9  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                                   &kp N4  &hmr RCTRL N5  &hmr RSHFT N6  &trans  &trans  &trans
